	(text "4-wire SPI: MOSI -> J4; MISO <- L6; CLK -> J5; CSB -> K6.\nRESETB -> K5; R4 10k pull-up is on Radio sheet 4.\nSPI maximum 50 MHz; timing: UG-570 Rev.A pp.113-115.\nFuture controller must drive RESETB; a pull-up is not a reset supervisor."
		(at 20.3200 132.0800 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8e1571db-c983-46e0-9781-6ee0aa886abb")
	)
